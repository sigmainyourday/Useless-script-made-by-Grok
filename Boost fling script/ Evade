-- Dragging logic and click toggling for ToggleBtn
local dragging = false
local moved = false
local dragStart
local startPosition
local activeInput
local DRAG_THRESHOLD = 10

ToggleBtn.InputBegan:Connect(function(input)
    local inputType = input.UserInputType
    if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then return end
    if dragging then return end

    dragging = true
    moved = false
    activeInput = input
    dragStart = input.Position
    startPosition = ToggleBtn.Position
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging or not dragStart or not startPosition then return end
    local mouseMove = activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement
    if input ~= activeInput and not mouseMove then return end

    local delta = input.Position - dragStart
    if delta.Magnitude > DRAG_THRESHOLD then
        moved = true
    end

    if moved then
        ToggleBtn.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

local function finishDrag(input)
    if not dragging then return end
    local matches = input == activeInput
    if not matches and activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1 then
        matches = true
    end
    if not matches then return end

    if not moved then
        setUIVisible(not uiVisible)
    end

    dragging = false
    moved = false
    dragStart = nil
    startPosition = nil
    activeInput = nil
end

ToggleBtn.InputEnded:Connect(finishDrag)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 then
        finishDrag(input)
    end
end)

local isFlinging = false
local lastFlingTime = 0
local DEBOUNCE_COOLDOWN = 0.5

-- [MAIN FLING FUNCTION] Applies velocity toward camera look direction and abruptly stops after delay
local function fling()
    local currentTime = tick()
    if isFlinging or (currentTime - lastFlingTime < DEBOUNCE_COOLDOWN) then 
        return 
    end

    lastFlingTime = currentTime

    local power = tonumber(PowerBox.Text) or 500000
    local delayTime = tonumber(DelayBox.Text) or 1.2
    if delayTime < 0 then delayTime = 1.2 end

    if not character or not character.Parent then
        character = player.Character or player.CharacterAdded:Wait()
        root = character:WaitForChild("HumanoidRootPart")
    end

    if not root or not root.Parent then return end

    local camera = Workspace.CurrentCamera
    if not camera then return end

    isFlinging = true
    local flingDirection = camera.CFrame.LookVector

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = true
    end

    local startTime = tick()
    local connection

    connection = RunService.RenderStepped:Connect(function()
        if not root or not root.Parent then
            if connection then connection:Disconnect() end
            isFlinging = false
            return
        end

        -- Completely stop Fling immediately when delay time is reached
        if tick() - startTime >= delayTime then
            if connection then connection:Disconnect() end

            -- Zero out character velocity and rotational state completely
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero

            if humanoid then
                humanoid.PlatformStand = false
            end
            
            isFlinging = false
            return
        end

        -- Continue applying acceleration during the Delay duration
        root.AssemblyLinearVelocity = flingDirection * power
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- [AUTO-TRIGGER ON DODGE INTEGRATION]
