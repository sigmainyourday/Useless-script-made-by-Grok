-- Fling in the direction the player's camera is facing - Small UI
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local root = character:WaitForChild("HumanoidRootPart")
local camera = Workspace.CurrentCamera

-- Small UI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FlingUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = player:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 160, 0, 95)
Frame.Position = UDim2.new(0.5, -80, 0.25, 0)
Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true
Frame.Parent = ScreenGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 8)
Corner.Parent = Frame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 22)
Title.BackgroundTransparency = 1
Title.Text = "Camera Fling"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 13
Title.Parent = Frame

local PowerBox = Instance.new("TextBox")
PowerBox.Size = UDim2.new(1, -16, 0, 24)
PowerBox.Position = UDim2.new(0, 8, 0, 28)
PowerBox.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
PowerBox.Text = "50000"
PowerBox.TextColor3 = Color3.fromRGB(255, 255, 255)
PowerBox.Font = Enum.Font.Gotham
PowerBox.TextSize = 13
PowerBox.ClearTextOnFocus = false
PowerBox.Parent = Frame

local BoxCorner = Instance.new("UICorner")
BoxCorner.CornerRadius = UDim.new(0, 5)
BoxCorner.Parent = PowerBox

local FlingBtn = Instance.new("TextButton")
FlingBtn.Size = UDim2.new(1, -16, 0, 26)
FlingBtn.Position = UDim2.new(0, 8, 0, 58)
FlingBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 255)
FlingBtn.Text = "FLING"
FlingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FlingBtn.Font = Enum.Font.GothamBold
FlingBtn.TextSize = 13
FlingBtn.Parent = Frame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 5)
BtnCorner.Parent = FlingBtn

-- Fling in the camera's facing direction
local function fling()
    local power = tonumber(PowerBox.Text) or 50000

    if not character or not character.Parent then
        character = player.Character or player.CharacterAdded:Wait()
        root = character:WaitForChild("HumanoidRootPart")
    end

    local old = root:FindFirstChild("FlingBV")
    if old then old:Destroy() end

    local look = camera.CFrame.LookVector
    local velocity = look * power -- Move in the direction the camera is facing

    local bv = Instance.new("BodyVelocity")
    bv.Name = "FlingBV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = velocity
    bv.Parent = root

    task.delay(1.2, function()
        if bv and bv.Parent then
            bv:Destroy()
        end
    end)
end

FlingBtn.MouseButton1Click:Connect(fling)

player.CharacterAdded:Connect(function(char)
    character = char
    root = char:WaitForChild("HumanoidRootPart")
end)

print("Camera Fling loaded!")
